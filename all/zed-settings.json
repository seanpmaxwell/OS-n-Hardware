// ChatGPT ultra minimal settings
{
  // Keep Tree-sitter syntax highlighting, but no LSP semantic highlighting.
  "semantic_tokens": "off",

  // --- Disable IDE/code-intelligence features ---
  "enable_language_server": false,

  "show_completions_on_input": false,
  "auto_signature_help": false,
  "show_signature_help_after_edits": false,

  "inlay_hints": {
    "enabled": false
  },

  // --- Disable AI completely ---
  "disable_ai": true,

  "edit_predictions": {
    "provider": "none"
  },

  "show_edit_predictions": false,

  // --- Restrict extensions ---
  // Extensions cannot execute commands, download files,
  // or install npm packages through Zed's extension APIs.
  "granted_extension_capabilities": [],

  // --- Don't automatically load development environments ---
  "load_direnv": "disabled",

  // --- Diagnostics ---
  "diagnostics_max_severity": "off",

  "diagnostics": {
    "button": false,
    "inline": {
      "enabled": false
    }
  },

  // --- Minimal editor chrome ---
  "minimap": {
    "show": "never"
  },

  "scrollbar": {
    "show": "auto",
    "diagnostics": "none",
    "git_diff": false,
    "selected_symbol": false
  },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },

  // --- Project/file sidebar ---
  "project_panel": {
    "button": false,
    "starts_open": false,
    "git_status": false,
    "show_diagnostics": "off"
  },

  // --- Tabs ---
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },

  "tabs": {
    "file_icons": false,
    "git_status": false,
    "show_close_button": "hover",
    "show_diagnostics": "off"
  },

  // --- Git ---
  "git": {
    "git_gutter": "hide",

    "inline_blame": {
      "enabled": false
    }
  },

  "git_panel": {
    "button": false,
    "starts_open": false
  },

  // --- Terminal ---
  "terminal": {
    "starts_open": false
  },

  // --- Debugger ---
  "debugger": {
    "button": false
  },

  // --- Collaboration ---
  "collaboration_panel": {
    "button": false
  },

  // --- Status bar ---
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true,
    "line_endings_button": false
  },

  // --- Show ruler ---
  "preferred_line_length": 80,
  // "soft_wrap": "none",
  "show_wrap_guides": true,
  "wrap_guides": [120],
  "ui_font_size": 16,
  "buffer_font_size": 12.5,
  "soft_wrap": "editor_width",

  // Theme
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  }
}
